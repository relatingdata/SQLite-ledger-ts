#!/usr/bin/env bash
# The manual and the code may not differ: every commit runs the same gates
# as `make test` and CI (`make check-manual`). `make install` enables this
# hook (git config core.hooksPath githooks).
# Documented in docs/pm-build-and-tooling.md, "Gates".
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
if ! make -s check-manual; then
  echo ""
  echo "pre-commit: the Programmer's Manual and the code disagree (see GATE FAILED above). Fix the manual or the code, then commit."
  exit 1
fi
