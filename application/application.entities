   "/vouchers/general-ledger" :Screen Description="Batch approval for general journal entries \u2014 the same staged-then-approved workflow already used for journal_entry_staging, exposed as its own reviewable batch rather than one entry at a time." Template=not-implemented Title="General Ledger Batch"
   "/vouchers/payable" :Screen Description="Batch approval of accounts payable \u2014 stage several provider bills for a second person to review and approve together, rather than one at a time. A documented, confirmed gap (docs/TODO.md)." Template=not-implemented Title="Payable Batch"
   "/vouchers/payment" :Screen Description="Batch approval of a group of provider payments together, mirroring Payable Batch on the payment side." Template=not-implemented Title="Payment Batch"
  Styles Ordered>/Root/Active
   - :Rule Selector=.tiles display=grid gap=1rem grid-template-columns="repeat(auto-fill, minmax(220px, 1fr))"
   - :Rule Selector=.tile color="var(--ink)" display=block padding="1.1rem 1.2rem" text-decoration=none
   - :Rule Selector=.tile border-color="var(--brass)"
   - :Rule Selector=".tile h3" color="var(--brass-dark)" margin="0 0 0.4rem"
   - :Rule Selector=".tile p" color="var(--ink-soft)" font-size="var(--font-size-base)" margin=0
   - :Rule Selector=.dim color="var(--ink-soft)" font-size="var(--font-size-medium)"
   - :Rule Selector=.link-button background=none border=none color="var(--accent, #2a5c8a)" cursor=pointer padding=0 text-decoration=underline
   - :Rule Selector=.row align-items=flex-end display=flex flex-wrap=wrap gap=0.8rem margin-top=0.6rem
   - :Rule Selector=.grow flex=1 min-width=180px
   - :Rule Selector=.intro max-width=70ch
   - :Rule Selector=.center-text text-align=center
   - :Rule Selector=.context-line border-bottom="1px solid var(--rule)" color="var(--ink-soft)" font-size="var(--font-size-base)" margin="0 0 0.8rem" padding-bottom=0.6rem
   - :Rule Selector=".row-3, .row-2" display=flex gap=1rem margin-top=0.6rem
   - :Rule Selector=".row-3 fieldset, .row-2 fieldset" flex=1
   - :Rule Selector=".lines-table th, .lines-table td" border-bottom="1px solid var(--rule)" padding="0.35rem 0.5rem" text-align=start
   - :Rule Selector=.num text-align=end
   - :Rule Selector=.num-input text-align=end width=6rem
   - :Rule Selector=.storage-cell white-space=nowrap
   - :Rule Selector=.storage-tag border-radius=4px display=inline-block font-size="var(--font-size-small)" font-weight=600 padding="0.1rem 0.5rem"
   - :Rule Selector=.storage-tag.cold background="#e3f0fb" color="#1e5f8f"
   - :Rule Selector=.storage-tag.shelf background="#f5efe3" color="#8a6a2a"
   - :Rule Selector=.btn.small font-size="var(--font-size-small)" padding="0.2rem 0.5rem"
   - :Rule Selector=.total-line color="var(--ink-soft)" font-size="var(--font-size-medium)" margin="0.8rem 0"
   - :Rule Selector=.one-of align-items=center display=flex gap=1.2rem margin="0.8rem 0"
   - :Rule Selector=".one-of label" align-items=center display=flex font-weight=normal gap=0.3rem
   - :Rule Selector=.error color="var(--debit, #a33a2e)"
   - :Rule Selector=.success background="#eaf5ea" border-radius=5px color="#2a5c2a" padding="0.5rem 0.7rem"
   - :Rule Selector=.checkbox-label align-items=center display=flex gap=0.4rem
   - :Rule Selector=.report-controls justify-content=center margin-bottom=1rem
   - :Rule Selector=.report-columns align-items=end display=grid gap=1.2rem grid-template-columns="repeat(auto-fit, minmax(320px, 1fr))"
   - :Rule Selector=.report-column display=flex flex-direction=column gap=1.2rem
   - :Rule Selector=.report-group margin=0 padding="1rem 1.2rem 1.2rem"
   - :Rule Selector=.report-table border-collapse=collapse margin=0 width="100%"
   - :Rule Selector=".report-table th, .report-table td" border-bottom="1px solid var(--rule)" padding="0.35rem 0.6rem" text-align=start
   - :Rule Selector=".report-table .num" text-align=end
   - :Rule Selector=".report-table tfoot td" border-bottom=none border-top="2px solid var(--rule-strong)"
   - :Rule Selector=.mono font-variant-numeric=tabular-nums
   - :Rule Selector=.contra color="var(--debit, #b1442e)"
   - :Rule Selector=.clickable cursor=pointer
   - :Rule Selector=".clickable:hover td" background="var(--paper-dim, #f2ede1)"
   - :Rule Selector=.disclosure color="var(--ink-soft)" display=inline-block width=1rem
   - :Rule Selector=.warn color="var(--danger, #b00)" font-size=0.9em font-weight=600
   - :Rule Selector=.badge background="var(--rule-strong)" border-radius=3px color="var(--ink-soft)" cursor=help display=inline-block font-size=0.75em margin-inline-start=0.4em padding="0.05em 0.4em"
   - :Rule Selector=.report-summary display=flex font-size="var(--font-size-medium)" justify-content=space-between margin=0 padding="0 1.2rem"
   - :Rule Selector=.report-status color="var(--debit)" font-weight=600 margin-top=1rem text-align=center
   - :Rule Selector=.report-status.balanced color="var(--credit)"
   - :Rule Selector=".critical td" color="var(--debit)" font-weight=600
   - :Rule Selector=.ok color="var(--credit)"
   - :Rule Selector=.report-meta display=flex flex-wrap=wrap gap="0 1.5rem" margin-bottom=0.6rem
   - :Rule Selector=".report-meta p" margin=0
   - :Rule Selector=.toggle-group display=flex gap=0.3rem
   - :Rule Selector=".toggle-group .active" background="var(--brass)" color=white
   - :Rule Selector=.record-list border-collapse=collapse margin-top=1.2rem width="100%"
   - :Rule Selector=".record-list th, .record-list td" border-bottom="1px solid var(--rule)" padding="0.4rem 0.6rem" text-align=start
   - :Rule Selector=.record-actions white-space=nowrap
   - :Rule Selector=".record-actions button" margin-inline-end=0.4rem
   - :Rule Selector=.status background="var(--rule)" border-radius=999px font-size="var(--font-size-small)" padding="0.1rem 0.5rem" text-transform=capitalize
   - :Rule Selector=.status-accepted background="var(--credit)" color=white
   - :Rule Selector=".status-rejected, .status-expired" background="var(--debit)" color=white
   - :Rule Selector=.reject color="var(--debit)"
