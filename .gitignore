node_modules/
# A symlink to the root node_modules/ above (git's dir-match pattern
# doesn't follow it since it's a symlink, not a real directory) -
# excluded explicitly rather than committed.
tui/node_modules
dist/
.svelte-kit/
backend/data/*.sqlite
backend/data/*.sqlite-wal
backend/data/*.sqlite-shm
backend/data/archive/
*.log
.DS_Store
__pycache__/
*.pyc

# Real, generated build artifacts — regenerate via `make manual` /
# `make programmer-manual` / `make historical-manual` rather than
# committing the output itself.
docs/programmer-manual.md
docs/old/historical-manual.md
sql-ledger-ts_User_Manual.pdf
sql-ledger-ts_Programmer_Manual.pdf
sql-ledger-ts_Historical_Design_Log.pdf

# Per direct, absolute instruction: never commit manuals or
# screenshots of any kind, ever - regenerate locally via `make
# manual-screenshots` / `make manual` / `make programmer-manual`.
docs/manual-images/
docs/manual-images-*/
*.pdf

test-results/

# A real, temporary, per-checkpoint file - written fresh before each
# `make checkpoint` run, deleted immediately after. Never meant to be
# tracked.
COMMIT_MSG.txt

docs/diagrams/.puppeteer-config.generated.json

# The Gleam storage engine: build output and its own scratch databases.
