  Styles Ordered>/Root/Active
   - :Rule Selector=".report-table .group-heading td" font-weight=700 padding-top=0.6rem
   - :Rule Selector=.form-status background="var(--paper-dim, #f2ede1)" border-radius=4px margin="0 0 1rem" padding="0.6rem 0.9rem"
   - :Rule Selector=.preview font-family="var(--font-mono)" font-size="var(--font-size-medium)" margin=0
   - :Rule Selector=.review-card background="var(--paper)" border="1px solid var(--rule-strong, #ccc)" border-radius=8px box-sizing=border-box margin="0 auto 1.2rem" max-width=720px padding="1.2rem 1.3rem" width="100%"
   - :Rule Selector=.cards display=flex flex-wrap=wrap gap=1rem justify-content=center
   - :Rule Selector=.record-card display=flex flex-direction=column gap=0.6rem padding="1.1rem 1.2rem 1.3rem" width=320px
   - :Rule Selector=.summary-card background="#fdf6e8" border="1px solid #d9a441" border-radius=8px box-sizing=border-box margin="0 auto 1.2rem" max-width=900px padding="1.2rem 1.3rem" width="100%"
   - :Rule Selector=".summary-card h3" margin-top=0
   - :Rule Selector=".summary-table th, .summary-table td" border-bottom="1px solid var(--rule)" padding="0.4rem 0.6rem" text-align=left
   - :Rule Selector=".summary-table .num" text-align=right
   - :Rule Selector=.list-wrap margin="0 auto 1.2rem" max-width=900px width="100%"
   - :Rule Selector=.list-row align-items=center display=flex gap=0.6rem
   - :Rule Selector=".list-row .cell" flex="1 1 0"
   - :Rule Selector=".list-row .cell.num" flex="0 0 8rem" text-align=right
   - :Rule Selector=".list-row .cell.hint" flex="0 0 auto"
   - :Rule Selector=.list-header color="var(--ink-soft)" font-weight=bold padding="0 0.7rem 0.4rem"
   - :Rule Selector=".action-bar, .action-form, .prototype-form" align-items=center display=flex flex-wrap=wrap gap=0.5rem margin-top=0.8rem
   - :Rule Selector=.lists align-items=flex-start display=flex flex-wrap=wrap gap=1rem
