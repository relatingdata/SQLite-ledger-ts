  Components
   AddressList :Component "Calls deleteTypedAddress">/Root/Application/Calls/deleteTypedAddress "Calls getTypedAddresses">/Root/Application/Calls/getTypedAddresses "Calls listAddressTypes">/Root/Application/Calls/listAddressTypes "Calls setTypedAddress">/Root/Application/Calls/setTypedAddress Source="frontend/src/lib/components/AddressList.svelte"
    - :Use Component>/Root/Application/Components/TypedList "Prop canSave"="{(values) => !!String(values.lines ?? '').trim()}" "Prop emptyText"="No addresses yet \u2014 click here and press Insert to add one." "Prop entityName"="{entityName}" "Prop getItems"="{getTypedAddresses}" "Prop initialValues"="{() => ({ businessName: '', lines: '', city: '', region: '', postal: '', country: '' })}" "Prop kindLabel"=Addresses "Prop listTypes"="{listAddressTypes}" "Prop newTypePlaceholder"="e.g. Head Office, Warehouse, Site Office" "Prop remove"="{deleteTypedAddress}" "Prop save"="{(name, type, values) => {\n    const lines = String(values.lines ?? '').split('\\n');\n    return setTypedAddress(name, {\n      address_type: type,\n      business_name: (values.businessName as string) || null,\n      address_line1: lines[0] || null,\n      address_line2: lines.slice(1).join('\\n') || null,\n      city: (values.city as string) || null,\n      region: (values.region as string) || null,\n      postal_code: (values.postal as string) || null,\n      country: (values.country as string) || null,\n    });\n  }}" "Prop typeField"=address_type
    - :Field Control=input Placeholder="e.g. Acme Pty Ltd \u2014 leave blank if this is a personal address"
    - :Field Control=textarea Placeholder="e.g. Unit 4, 42 Market Street"
    - :Field Control=input Placeholder="{translations.current['City'] ?? 'City'}"
    - :Field Control=input Placeholder="Region / State"
    - :Field Control=input Placeholder="{translations.current['Postal code'] ?? 'Postal code'}"
    - :Field Control=input Placeholder="{translations.current['Country'] ?? 'Country'}"
   AxisPLNode :Component Source="frontend/src/lib/components/AxisPLNode.svelte"
    - :Action Handler="() => (open = !open)"
    - :Use Component>/Root/Application/Components/ProfitAndLossTable "Prop pl"="{node.profitAndLoss}"
    - :Use Component>/Root/Application/Components/AxisPLNode "Prop depth"="{depth + 1}" "Prop node"="{child}"
   BusinessStructurePopup :Component "Calls createDepartment">/Root/Application/Calls/createDepartment "Calls createHierarchyGrouping">/Root/Application/Calls/createHierarchyGrouping "Calls createHierarchyValue">/Root/Application/Calls/createHierarchyValue "Calls createLocation">/Root/Application/Calls/createLocation "Calls deleteDepartment">/Root/Application/Calls/deleteDepartment "Calls deleteEmployeeDepartment">/Root/Application/Calls/deleteEmployeeDepartment "Calls deleteEmployeeManager">/Root/Application/Calls/deleteEmployeeManager "Calls deleteHierarchyGrouping">/Root/Application/Calls/deleteHierarchyGrouping "Calls deleteHierarchyTag">/Root/Application/Calls/deleteHierarchyTag "Calls deleteHierarchyValue">/Root/Application/Calls/deleteHierarchyValue "Calls deleteLocation">/Root/Application/Calls/deleteLocation "Calls getHierarchy">/Root/Application/Calls/getHierarchy "Calls getHierarchyAssignments">/Root/Application/Calls/getHierarchyAssignments "Calls getHierarchyTag">/Root/Application/Calls/getHierarchyTag "Calls getLocationTypes">/Root/Application/Calls/getLocationTypes "Calls getOrgChartStructure">/Root/Application/Calls/getOrgChartStructure "Calls listDepartments">/Root/Application/Calls/listDepartments "Calls listLocations">/Root/Application/Calls/listLocations "Calls setEmployeeDepartment">/Root/Application/Calls/setEmployeeDepartment "Calls setEmployeeManager">/Root/Application/Calls/setEmployeeManager "Calls setHierarchyTag">/Root/Application/Calls/setHierarchyTag Source="frontend/src/lib/components/BusinessStructurePopup.svelte"
    - :Heading Text="Business Structure"
