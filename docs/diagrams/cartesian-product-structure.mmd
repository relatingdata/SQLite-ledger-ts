graph LR
    subgraph HIERARCHY["Hierarchy (a business's groupings and values)"]
        direction TB
        HBEER["Beer"] --> HLAGER["Lager"]
        HSTORAGE["Storage"] --> HCOLD["Cold"]
        HLOCATION["Location"] --> HRIV["Riverside Cellars"]
    end
    subgraph PRODUCT["Product"]
        direction TB
        DEF["A Definition (defineProductShape)<br/>[Location, Location] [Item, Beer] [Storage, Storage]"]
        INST["One Instance (ensureProductInstance)<br/>combination_ids = [id of Riverside Cellars, id of Lager, id of Cold]"]
    end
    subgraph ACCOUNTS["Chart of Accounts"]
        direction TB
        INV["Inventory → new leaf"]
        SAL["Sales Revenue → new leaf"]
        COGS["Cost of Goods Sold → new leaf"]
    end
    INST -. "ids of" .-> HRIV
    INST -. "ids of" .-> HLAGER
    INST -. "ids of" .-> HCOLD
    INV -. relation_id .-> INST
    SAL -. relation_id .-> INST
    COGS -. relation_id .-> INST
    style HIERARCHY fill:#fdd
    style PRODUCT fill:#eef
    style ACCOUNTS fill:#dfd
